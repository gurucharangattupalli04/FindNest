# ==============================================================================
# FindNest Backend Environment Configuration
# ==============================================================================

# Application Settings
PROJECT_NAME="FindNest API"
VERSION="1.0.0"
API_V1_STR="/api/v1"
CORS_ORIGINS='["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000"]'

# ==============================================================================
# Database Configuration (PostgreSQL)
# ==============================================================================
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=findnest

# Direct Database URL (Optional: takes precedence over discrete POSTGRES_* settings)
# Example for standard PostgreSQL:
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/findnest
# Example for SSL-enabled cloud PostgreSQL (e.g., Supabase / Neon / AWS RDS):
# DATABASE_URL=postgresql://user:password@ep-sample.us-east-1.aws.neon.tech/findnest?sslmode=require

# ==============================================================================
# Authentication & JWT Configuration
# ==============================================================================
# Generate a secure 256-bit random key in production (e.g. `openssl rand -hex 32`)
JWT_SECRET_KEY="replace-with-a-secure-random-secret-key-minimum-32-chars"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ==============================================================================
# Firebase Storage Configuration (Step 6)
# ==============================================================================
# Path to your Firebase service account JSON key file (e.g. ./firebase-key.json)
# If left empty, FindNest uses the local storage fallback for dev/testing.
FIREBASE_CREDENTIALS_PATH=
# Your Firebase Storage Bucket name (e.g. your-project-id.appspot.com or your-project.firebasestorage.app)
FIREBASE_STORAGE_BUCKET=
# Maximum image upload size in Megabytes (default: 5MB)
MAX_UPLOAD_SIZE_MB=5

# ==============================================================================
# Gemini AI & Multimodal Embedding Configuration (Step 7)
# ==============================================================================
# Your Google Gemini API Key. Never expose this key to the frontend.
# If omitted or invalid, item creation succeeds normally and embedding is safely skipped.
GEMINI_API_KEY=
# Target Gemini Embedding Model (defaults to gemini-embedding-2)
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
# Output embedding dimensionality (768 or 3072)
EMBEDDING_DIMENSIONS=768

# ==============================================================================
# Smart Match Notification & Email Configuration (Step 10)
# ==============================================================================
# Confidence score threshold for automatic match alerts (defaults to 75.0%)
NOTIFICATION_MATCH_THRESHOLD=75.0

# Master toggle for email delivery (true/false). When false, emails are safely logged to console.
EMAIL_ENABLED=false

# Email provider: "console" (local dev), "resend" (Resend REST API), or "smtp" (Standard SMTP)
EMAIL_PROVIDER=console

# Sender address shown in outbound email alerts
EMAIL_FROM="FindNest Alerts <notifications@findnest.local>"

# Resend API Key (required if EMAIL_PROVIDER=resend)
RESEND_API_KEY=

# SMTP Server Configuration (required if EMAIL_PROVIDER=smtp)
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=true

# Frontend public URL for links embedded in notification emails
FRONTEND_URL=http://localhost:5173
