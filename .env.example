# ==============================================================================
# FindNest - Root Environment Template
# (Do NOT commit your real .env file with actual credentials)
# ==============================================================================

# Backend API URL (Frontend connects to this)
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Backend Core Configuration
PROJECT_NAME="FindNest API"
VERSION="1.0.0"
API_V1_STR="/api/v1"
CORS_ORIGINS='["http://localhost:5173", "http://127.0.0.1:5173"]'

# PostgreSQL Database (Supabase or Local)
DATABASE_URL=postgresql://postgres:your_password@db.your_project.supabase.co:5432/postgres?sslmode=require

# Authentication & JWT
JWT_SECRET_KEY=your_secure_256_bit_random_hex_key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Gemini AI Key (for multimodal semantic embeddings)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIMENSIONS=768

# Email Service (Resend or SMTP)
NOTIFICATION_MATCH_THRESHOLD=75.0
EMAIL_ENABLED=true
EMAIL_PROVIDER=resend
EMAIL_FROM="FindNest Alerts <onboarding@resend.dev>"
RESEND_API_KEY=your_resend_api_key_here
FRONTEND_URL=http://localhost:5173
